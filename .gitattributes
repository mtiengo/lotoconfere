# Normalize line endings so Windows, macOS and Linux contributors and CI agree.
* text=auto
*.py   text eol=lf
*.pyi  text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# PowerShell on Windows: CRLF, and never touched by eol=lf normalization.
*.ps1  text eol=crlf

# Build scripts run on Linux and macOS runners. A CRLF line ending here makes the
# kernel read the shebang as "/usr/bin/env bash\r" and the build dies at line one.
*.sh   text eol=lf

# Inno Setup's compiler is Windows-only.
*.iss  text eol=crlf

# Recorded endpoint responses are evidence, not text: Caixa sends CRLF inside its
# JSON, and normalising it rewrites the bytes the fixtures were checksummed on.
# Diffs stay readable; only the line-ending conversion is off.
tests/fixtures/** -text
